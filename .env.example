# Direct contact & fallback email
VITE_CONTACT_EMAIL=rahuladepu99@gmail.com

# Static Inquiry & Feedback Delivery (Works on BOTH GitHub Pages and Netlify):
# Option 1 (Recommended — Free tier): Get an access key at https://web3forms.com using rahuladepu99@gmail.com
VITE_WEB3FORMS_KEY=

# Option 2 (Optional): Formspree endpoint (e.g., https://formspree.io/f/xxxxxxxx)
VITE_FORMSPREE_ENDPOINT=

# Option 3 (Optional): Custom JSON webhook (n8n, Make, Cloudflare Worker)
VITE_INQUIRY_WEBHOOK_URL=

# Option 4 (Auto-enabled in netlify.toml when deployed on Netlify):
# VITE_ENABLE_NETLIFY_FORMS=true
