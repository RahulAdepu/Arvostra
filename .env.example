# Canonical Site URL (used in SEO metadata, OpenGraph, sitemap.xml, robots.txt)
NEXT_PUBLIC_SITE_URL=https://arvostra.com

# Optional Base Path:
# - Leave EMPTY ("") for Netlify or GitHub Pages with custom domain (arvostra.com)
# - Set to "/your-repo-name" ONLY if deploying to https://RahulAdepu.github.io/your-repo-name/
NEXT_PUBLIC_BASE_PATH=

# Direct contact & fallback email
NEXT_PUBLIC_CONTACT_EMAIL=rahuladepu99@gmail.com

# Static Inquiry Form Delivery (Works on BOTH GitHub Pages and Netlify):
# Option 1 (Recommended — Free tier): Get an access key at https://web3forms.com using rahuladepu99@gmail.com
NEXT_PUBLIC_WEB3FORMS_KEY=

# Option 2 (Optional): Formspree endpoint (e.g., https://formspree.io/f/xxxxxxxx)
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Option 3 (Optional): Custom JSON webhook (n8n, Make, Cloudflare Worker)
NEXT_PUBLIC_INQUIRY_WEBHOOK_URL=

# Option 4 (Auto-enabled in netlify.toml when deployed on Netlify):
# NEXT_PUBLIC_ENABLE_NETLIFY_FORMS=true
